{
  "name": "@njuptlzf/pi-hermes-memory",
  "version": "0.11.0-scoped.1",
  "description": "🧠 Persistent memory + 🔍 session search + 🛡️ secret scanning for Pi. Token-aware policy-only memory by default, SQLite FTS5 search, auto-consolidation, procedural skills. 732 tests. Ported from Hermes agent.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "agent-chat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scoped": {
      "agent-chat-source": "./src/scoped/entry.ts",
      "types": "./dist/scoped/entry.d.ts",
      "default": "./dist/scoped/entry.js"
    },
    "./scoped-provider": {
      "agent-chat-source": "./src/scoped/provider.ts",
      "types": "./dist/scoped/provider.d.ts",
      "default": "./dist/scoped/provider.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "node scripts/ensure-dev.mjs check && tsc --noEmit",
    "check:min-sdk": "node scripts/ensure-dev.mjs check && node scripts/check-min-sdk.mjs",
    "check:production": "node scripts/check-production-install.mjs",
    "test": "node scripts/ensure-dev.mjs test && tests/run-all.sh",
    "upstream:check": "node scripts/upstream-divergence.mjs",
    "upstream:check:ci": "node scripts/upstream-divergence.mjs --no-fetch --no-color",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "persistent-memory",
    "session-search",
    "sqlite",
    "fts5",
    "skills",
    "learning-loop",
    "agent",
    "hermes",
    "secret-scanning",
    "content-scanner",
    "correction-detection",
    "auto-consolidation",
    "memory-aging",
    "context-fencing",
    "two-tier-memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chandra447/pi-hermes-memory.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.6",
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@earendil-works/pi-tui": "^0.80.2",
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.21.0",
    "typebox": "^1.1.33",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "strip-ansi": "7.2.0"
  }
}
